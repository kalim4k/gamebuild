# Modèle à recopier en .env.local pour travailler en local.
# .env.local n'est JAMAIS versionné — le dépôt est public.
# Sur Vercel, ces trois valeurs se règlent dans
# Settings → Environment Variables.

# Chaîne de connexion Neon (onglet Connect du tableau de bord Neon).
DATABASE_URL="postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require"

# Mot de passe de l'espace admin (/admin). Mets-en un long.
ADMIN_MOT_DE_PASSE="un-mot-de-passe-long-et-unique"

# Sel du calcul d'empreinte des visiteurs. N'importe quelle chaîne longue.
# Si tu le changes, les visiteurs déjà comptés sont recomptés comme neufs.
HASH_SEL="une-autre-chaine-au-hasard"

# ── Réponses vocales ─────────────────────────────────────────
# Clé API ElevenLabs (Profile → API Keys) et identifiant de ta voix
# clonée (Voices → ta voix → ID). Sans ces deux-là, la bulle marche
# quand même, mais sans le « Salut Kossi » dans ta voix, et sans
# questions dictées.
ELEVENLABS_API_KEY="sk_..."
ELEVENLABS_VOICE_ID="..."

# Facultatif : reconnaître les questions écrites avec Claude plutôt
# qu'avec les seuls mots-clés de objections.json.
# ANTHROPIC_API_KEY="sk-ant-..."

# Facultatif : modèle de voix. eleven_multilingual_v2 par défaut.
# ELEVENLABS_MODELE="eleven_multilingual_v2"

# Facultatif : nombre de NOUVEAUX prénoms générés par jour (300 par défaut).
# SALUT_MAX_JOUR="300"
